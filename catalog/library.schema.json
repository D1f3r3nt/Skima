{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skima-library.schema.json",
  "title": "Skima library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "skills", "mcp", "subagents", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "$ref": "#/definitions/isoDate" },
    "skills": { "type": "array", "items": { "allOf": [{ "$ref": "#/definitions/item" }, { "properties": { "type": { "const": "skill" } } }] } },
    "mcp": { "type": "array", "items": { "allOf": [{ "$ref": "#/definitions/item" }, { "properties": { "type": { "const": "mcp" } }, "required": ["mcpDefinition"] }] } },
    "subagents": { "type": "array", "items": { "allOf": [{ "$ref": "#/definitions/item" }, { "properties": { "type": { "const": "subagent" } } }] } },
    "commands": { "type": "array", "items": { "allOf": [{ "$ref": "#/definitions/item" }, { "properties": { "type": { "const": "command" } } }] } }
  },
  "definitions": {
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}([.][0-9]+)?)?Z)?$" },
    "nullableIsoDate": { "anyOf": [{ "$ref": "#/definitions/isoDate" }, { "type": "null" }] },
    "category": { "enum": ["development", "testing", "documentation", "data", "devops", "security", "design", "productivity", "ai-agents", "other"] },
    "environmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "secret"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$" },
        "description": { "type": "string", "maxLength": 300 },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" }
      }
    },
    "mcpDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "transport", "environment"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
        "transport": { "enum": ["stdio", "http"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 100 },
        "args": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
        "url": { "type": "string", "pattern": "^https://" },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "name", "version"],
          "properties": {
            "registry": { "enum": ["npm", "pypi", "docker"] },
            "name": { "type": "string", "minLength": 1, "maxLength": 214 },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        "environment": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/environmentVariable" } }
      },
      "if": { "properties": { "transport": { "const": "stdio" } } },
      "then": { "required": ["command", "args"] },
      "else": { "required": ["url"] }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "origin", "name", "author", "description", "category", "tags", "source", "snapshot", "review", "requirements"],
      "properties": {
        "id": { "type": "string", "pattern": "^(catalog|imported|skima):[a-z0-9][a-z0-9._/-]{0,200}$" },
        "type": { "enum": ["skill", "mcp", "subagent", "command"] },
        "origin": { "enum": ["catalog", "imported", "skima"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "author": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "category": { "$ref": "#/definitions/category" },
        "tags": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" } },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path", "commit"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
            "path": { "type": "string", "maxLength": 500, "pattern": "^(?!/)(?!(.*/)?[.][.](/|$)).*$" },
            "ref": { "type": "string", "maxLength": 200 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stars", "license", "lastCommitAt", "verifiedAt"],
          "properties": {
            "stars": { "type": "integer", "minimum": 0 },
            "forks": { "type": "integer", "minimum": 0 },
            "license": { "anyOf": [{ "type": "string", "maxLength": 100 }, { "type": "null" }] },
            "lastCommitAt": { "$ref": "#/definitions/nullableIsoDate" },
            "verifiedAt": { "$ref": "#/definitions/isoDate" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "result"],
          "properties": {
            "date": { "$ref": "#/definitions/isoDate" },
            "result": { "enum": ["passed", "passed-with-notes", "not-reviewed"] },
            "verification": { "enum": ["installed-from-archive", "started-and-listed-tools", "verified-without-credentials", "definition-only"] },
            "notes": { "type": "string", "maxLength": 1000 }
          }
        },
        "requirements": { "type": "array", "uniqueItems": true, "items": { "enum": ["node", "python", "uv", "docker", "git", "network", "account"] } },
        "notice": { "anyOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
        "compatibleAgents": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
        "mcpDefinition": { "$ref": "#/definitions/mcpDefinition" },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceUrl", "localFolder", "importedCommit", "importedAt", "repositoryName"],
          "properties": {
            "sourceUrl": { "type": "string", "maxLength": 500 },
            "localFolder": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
            "importedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "importedAt": { "$ref": "#/definitions/isoDate" },
            "repositoryName": { "type": "string", "maxLength": 200 }
          }
        }
      }
    }
  }
}
