{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/34606/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/34606/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/34606/.local/bin/graphify.EXE hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "[ -n \"$SKIMA_HOOK_ACTIVE\" ] || SKIMA_HOOK_ACTIVE=1 claude -p \"Usa la skill readme-checker con la informacion recibida por stdin\" --model \"haiku\" --permission-mode acceptEdits --allowedTools \"Bash(git diff:*),Bash(git status:*),Bash(git log:*)\"",
            "timeout": 60,
            "statusMessage": "Actualizando el README"
          }
        ]
      }
    ]
  }
}
